[[node]]
id       = "Lime.onInit"
display  = "On Init"
category = "Lifecycle"
emit     = "struct:event"
target   = "Lime.onInit"
isEvent  = true
doc      = "Runs before the window exists, for engine configuration."
pin = [
  { name="out", dir="out", kind="exec" },
]

[[node]]
id       = "Lime.onStart"
display  = "On Start"
category = "Lifecycle"
emit     = "struct:event"
target   = "Lime.onStart"
isEvent  = true
doc      = "Runs once after the window exists."
pin = [
  { name="out", dir="out", kind="exec" },
]

[[node]]
id       = "Lime.onUpdate"
display  = "On Update"
category = "Lifecycle"
emit     = "struct:event"
target   = "Lime.onUpdate"
isEvent  = true
doc      = "Runs every frame with the delta time in seconds."
pin = [
  { name="out", dir="out", kind="exec" },
  { name="dt",  dir="out", type="number" },
]

[[node]]
id       = "Lime.onClose"
display  = "On Close"
category = "Lifecycle"
emit     = "struct:event"
target   = "Lime.onClose"
isEvent  = true
doc      = "Runs during shutdown."
pin = [
  { name="out", dir="out", kind="exec" },
]

[[node]]
id       = "core.branch"
display  = "Branch"
category = "Flow"
emit     = "struct:branch"
doc      = "if cond then ... else ... end"
pin = [
  { name="in",    dir="in",  kind="exec" },
  { name="cond",  dir="in",  type="boolean" },
  { name="true",  dir="out", kind="exec" },
  { name="false", dir="out", kind="exec" },
]

[[node]]
id       = "core.while"
display  = "While"
category = "Flow"
emit     = "struct:while"
doc      = "while cond do ... end"
pin = [
  { name="in",   dir="in",  kind="exec" },
  { name="cond", dir="in",  type="boolean" },
  { name="body", dir="out", kind="exec" },
  { name="out",  dir="out", kind="exec" },
]

[[node]]
id       = "core.forNum"
display  = "For Loop"
category = "Flow"
emit     = "struct:fornum"
doc      = "for i = from, to, step do ... end"
pin = [
  { name="in",   dir="in",  kind="exec" },
  { name="from", dir="in",  type="number", default="1" },
  { name="to",   dir="in",  type="number", default="10" },
  { name="step", dir="in",  type="number", optional=true },
  { name="body", dir="out", kind="exec" },
  { name="i",    dir="out", type="number" },
  { name="out",  dir="out", kind="exec" },
]

[[node]]
id       = "core.forIn"
display  = "For Each"
category = "Flow"
emit     = "struct:forin"
doc      = "for k, v in pairs(t) do ... end"
pin = [
  { name="in",    dir="in",  kind="exec" },
  { name="table", dir="in",  type="table" },
  { name="body",  dir="out", kind="exec" },
  { name="k",     dir="out", type="any" },
  { name="v",     dir="out", type="any" },
  { name="out",   dir="out", kind="exec" },
]

[[node]]
id       = "core.break"
display  = "Break"
category = "Flow"
emit     = "struct:break"
pin = [
  { name="in", dir="in", kind="exec" },
]

[[node]]
id       = "core.return"
display  = "Return"
category = "Flow"
emit     = "struct:return"
pin = [
  { name="in",    dir="in", kind="exec" },
  { name="value", dir="in", type="any", optional=true },
]

[[node]]
id       = "core.sequence"
display  = "Sequence"
category = "Flow"
emit     = "struct:sequence"
doc      = "Runs each output in order."
pin = [
  { name="in", dir="in",  kind="exec" },
  { name="a",  dir="out", kind="exec" },
  { name="b",  dir="out", kind="exec" },
  { name="c",  dir="out", kind="exec" },
]

[[node]]
id       = "core.number"
display  = "Number"
category = "Literal"
emit     = "literal"
pure     = true
pin = [
  { name="value", dir="in",  type="number", default="0" },
  { name="ret",   dir="out", type="number" },
]

[[node]]
id       = "core.string"
display  = "String"
category = "Literal"
emit     = "literal"
pure     = true
pin = [
  { name="value", dir="in",  type="string", default="" },
  { name="ret",   dir="out", type="string" },
]

[[node]]
id       = "core.boolean"
display  = "Boolean"
category = "Literal"
emit     = "literal"
pure     = true
pin = [
  { name="value", dir="in",  type="boolean", default="false" },
  { name="ret",   dir="out", type="boolean" },
]

[[node]]
id       = "core.nil"
display  = "Nil"
category = "Literal"
emit     = "literal"
pure     = true
pin = [
  { name="ret", dir="out", type="any" },
]

[[node]]
id       = "Vec2.new"
display  = "Make Vec2"
category = "Math/Vector"
emit     = "construct"
target   = "Vec2.new"
pure     = true
pin = [
  { name="x",   dir="in",  type="number", default="0" },
  { name="y",   dir="in",  type="number", default="0" },
  { name="ret", dir="out", type="Vec2" },
]

[[node]]
id       = "Vec3.new"
display  = "Make Vec3"
category = "Math/Vector"
emit     = "construct"
target   = "Vec3.new"
pure     = true
pin = [
  { name="x",   dir="in",  type="number", default="0" },
  { name="y",   dir="in",  type="number", default="0" },
  { name="z",   dir="in",  type="number", default="0" },
  { name="ret", dir="out", type="Vec3" },
]

