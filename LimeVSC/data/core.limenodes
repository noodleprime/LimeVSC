[[node]]
id       = "core.raw"
display  = "Raw Lua"
category = "Advanced"
emit     = "raw"
doc      = "Runs a .lua script, or literal Lua you type in."
pin = [
  { name="in",  dir="in",  kind="exec" },
  { name="script", dir="in", type="Asset:Script", optional=true },
  { name="out", dir="out", kind="exec" },
]

[[node]]
id       = "core.comment"
display  = "Comment"
category = "Annotation"
emit     = "struct:comment"
doc      = "A resizable box that groups nodes."
pin = []

[[node]]
id       = "core.reroute"
display  = "Reroute"
category = "Annotation"
emit     = "reroute"
pure     = true
doc      = "A wire waypoint that passes its input straight through."
pin = [
  { name="in",  dir="in",  type="any" },
  { name="ret", dir="out", type="any" },
]

[[node]]
id       = "behaviour.onSpawn"
display  = "On Spawn"
category = "Behaviour"
doc      = "Runs once when this entity is created."
emit     = "struct:behaviour"
target   = "onSpawn"
isEvent  = true
color    = "7ec86aff"
pin = [
  { name = "out",  dir = "out", kind = "exec" },
  { name = "self", dir = "out", type = "SceneObject" },
]

[[node]]
id       = "behaviour.onTick"
display  = "On Tick"
category = "Behaviour"
doc      = "Runs every frame with dt, the seconds since the last one."
emit     = "struct:behaviour"
target   = "onTick"
isEvent  = true
color    = "7ec86aff"
pin = [
  { name = "out",  dir = "out", kind = "exec" },
  { name = "self", dir = "out", type = "SceneObject" },
  { name = "dt",   dir = "out", type = "number" },
]

[[node]]
id       = "behaviour.onDestroy"
display  = "On Destroy"
category = "Behaviour"
doc      = "Runs once just before this entity is removed."
emit     = "struct:behaviour"
target   = "onDestroy"
isEvent  = true
color    = "7ec86aff"
pin = [
  { name = "out",  dir = "out", kind = "exec" },
  { name = "self", dir = "out", type = "SceneObject" },
]

[[node]]
id       = "scene.start"
display  = "Start Scene"
category = "Scene"
doc      = "Loads the project's start scene and keeps it ticking."
emit     = "call"
target   = "require"
color    = "c86ac8ff"
pin = [
  { name = "in",     dir = "in",  kind = "exec" },
  { name = "module", dir = "in",  type = "string", default = "\"content.lime_boot\"" },
  { name = "out",    dir = "out", kind = "exec" },
]

[[node]]
id       = "core.reroute.exec"
display  = "Reroute (exec)"
category = "Annotation"
emit     = "reroute.exec"
doc      = "An exec waypoint that passes control straight through."
pin = [
  { name="in",  dir="in",  kind="exec" },
  { name="out", dir="out", kind="exec" },
]
